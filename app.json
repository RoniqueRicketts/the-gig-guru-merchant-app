{
  "expo": {
    "name": "GigGuru Merchant",
    "slug": "the-gigguru-merchant",
    "description": "Simple tools for GigGuru merchants.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gigguru-app-icon.png",
    "scheme": "thegiggurumerchantapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/gigguru-app-icon.png",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#013000",
        "foregroundImage": "./assets/images/lime-green-logo.png",
        "monochromeImage": "./assets/images/lime-green-logo.png"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lime-green-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#013000",
          "image": "./assets/images/white-logo.png",
          "imageWidth": 68
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock your business data."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to pin your business on the GigGuru map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48bcc74a-7e06-40a2-80c8-c0fbd96a3046"
      }
    },
    "owner": "rickettstechltd"
  }
}
