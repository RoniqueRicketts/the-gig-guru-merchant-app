{
  "expo": {
    "name": "GigGuru Merchant",
    "slug": "the-gig-guru-merchant-app",
    "description": "Simple tools for GigGuru merchants.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gigguru-app-icon.png",
    "scheme": "thegiggurumerchantapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/gigguru-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#013000",
        "foregroundImage": "./assets/images/lime-green-logo.png",
        "monochromeImage": "./assets/images/lime-green-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lime-green-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#013000",
          "image": "./assets/images/white-logo.png",
          "imageWidth": 68
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
